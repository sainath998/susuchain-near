{
  "name": "susuchain-near",
  "version": "1.0.0",
  "description": "Rotating savings circles on NEAR, enforced by a contract",
  "scripts": {
    "build": "near-sdk-js build src/contract.js build/susuchain.wasm && near-sdk-js build src/test-usdc.js build/test_usdc.wasm",
    "test": "ava --timeout=10m --serial",
    "dev": "vite --port 5173",
    "build:web": "vite build",
    "seed": "node scripts/seed.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hot-labs/near-connect": "^0.12.0",
    "near-sdk-js": "^2.0.0"
  },
  "devDependencies": {
    "ava": "^8.4.0",
    "near-api-js": "^7.5.3",
    "near-cli-rs": "^0.31.1",
    "near-workspaces": "^5.0.0",
    "vite": "^6.3.5"
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ]
  }
}